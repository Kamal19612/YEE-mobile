# SPA React : toutes les routes (ex. /login) → index.html
# Nécessaire sur Hostinger / Apache / LiteSpeed (pas sur GitHub Pages).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
