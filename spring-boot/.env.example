# Backend Spring Boot — AfrEA-YEE
# Copier vers spring-boot/.env (déjà fait pour Supabase local).
# Ne jamais committer de secrets.

# dev = liens de vérification dans le JSON, SQL visible. Réservé au poste local.
# Sur un serveur exposé : SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=dev

# --- Supabase LOCAL (défaut) : npx supabase start ---
# DB :15422, API Kong :15421 (évite la plage Windows Hyper-V 54311-54410)
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:15422/postgres
# Premier démarrage, le temps que Flyway applique V15 : compte postgres.
# Ensuite, hors du dépôt : ALTER ROLE yee_api PASSWORD '...';
# puis SPRING_DATASOURCE_USERNAME=yee_api et ce mot de passe.
# Transférer aussi la propriété des tables (sinon ADD COLUMN Flyway échoue).
# Sur Supabase, postgres n'est pas superuser : GRANT yee_api TO postgres; d'abord.
#   GRANT yee_api TO postgres;
#   DO $$ DECLARE r record; BEGIN
#     FOR r IN SELECT tablename FROM pg_tables
#       WHERE schemaname='public' AND tablename <> 'flyway_schema_history'
#     LOOP EXECUTE format('ALTER TABLE public.%I OWNER TO yee_api', r.tablename);
#     END LOOP; END $$;
# Ne pas laisser l'API en superuser sur un serveur exposé.
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Supabase CLOUD (optionnel) ---
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres
# SPRING_DATASOURCE_USERNAME=yee_api
# SPRING_DATASOURCE_PASSWORD=
# PROD PgBouncer : port 6543 + prepareThreshold=0
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:6543/postgres?sslmode=require&prepareThreshold=0

# CORS + garde-fou Origin sur POST /api/auth/refresh
APP_ALLOWED_ORIGINS=http://localhost:5173

# Proxies dont X-Forwarded-For est pris en compte (Apache local).
# Une connexion directe utilise l'adresse TCP, pas l'en-tête.
# APP_TRUSTED_PROXIES=127.0.0.1,::1

# URL du front (liens dans les emails verify/reset)
APP_FRONTEND_URL=http://localhost:5173

# Auth JWT — minimum 32 caractères (HS256)
APP_JWT_SECRET=local-dev-jwt-secret-at-least-32-bytes!!
APP_JWT_ISSUER=yee-api

# Cookie refresh — en local HTTP : Lax + Secure=false
APP_COOKIE_SAMESITE=Lax
APP_COOKIE_SECURE=false

# Storage : local (dev) | supabase
# chat-media et group-post-media ne doivent pas être des buckets publics :
# l'API les sert après contrôle. avatars, covers et post-media (fil global
# et groupes public) peuvent rester publics.
APP_STORAGE_PROVIDER=local
APP_STORAGE_LOCAL_ROOT=./data/storage
# Avatars/covers same-origin (hors préfixe /api). post-media passe par /api/media/…
# En prod : /media ou https://cdn…/media
APP_STORAGE_LOCAL_PUBLIC_BASE_URL=/media
SUPABASE_URL=http://127.0.0.1:15421
# Clé service_role : uniquement ici (serveur), jamais dans le front React.
# V15 lui retire les droits SQL sur public. Ne pas la coller dans le navigateur.
# SUPABASE_SERVICE_ROLE_KEY=

# Link preview SSRF — hôtes bloqués (domaine API / site), virgules
APP_LINK_PREVIEW_BLOCKED_HOSTS=localhost,127.0.0.1

# Local only — affiche le lien verify/reset dans la réponse API si SMTP absent.
# En prod (profil Spring prod) ce drapeau est forcé à false.
APP_DEV_EXPOSE_EMAIL_LINKS=true

# --- SMTP (optionnel en local ; obligatoire pour une ouverture réelle) ---
# Sans SPRING_MAIL_HOST : aucun envoi, seul le mode expose-email-links reste.
# Mailpit / MailHog local (pas d’auth, pas de STARTTLS) :
#   docker run -d --name mailpit -p 8025:8025 -p 1025:1025 axllent/mailpit
#   puis UI http://127.0.0.1:8025
# SPRING_MAIL_HOST=127.0.0.1
# SPRING_MAIL_PORT=1025
# SPRING_MAIL_SMTP_AUTH=false
# SPRING_MAIL_SMTP_STARTTLS=false
# APP_MAIL_FROM=AfrEA-YEE <noreply@localhost>
#
# Serveur SMTP réel (exemple STARTTLS / port 587) :
# SPRING_MAIL_HOST=smtp.example.org
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=yee@example.org
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=true
# SPRING_MAIL_SMTP_SSL=false
# APP_MAIL_FROM=AfrEA-YEE <noreply@example.org>
#
# SMTPS (port 465) : STARTTLS=false et SSL=true
# SPRING_MAIL_PORT=465
# SPRING_MAIL_SMTP_STARTTLS=false
# SPRING_MAIL_SMTP_SSL=true
#
# Test live (sans afficher .env) :
#   ./scripts/test-smtp.sh
#   SMTP_TEST_TO=vous@example.com ./scripts/test-smtp.sh

# Purge quotidienne (cron Spring) — défaut 03:30 UTC
# APP_RETENTION_CRON=0 30 3 * * *

# --- Web Push (PWA iOS écran d’accueil + Android Chrome) ---
# Générer une paire : npx web-push generate-vapid-keys
# Sans ces clés, l’API push répond enabled:false (SSE reste actif).
# APP_VAPID_PUBLIC_KEY=
# APP_VAPID_PRIVATE_KEY=
# APP_VAPID_SUBJECT=mailto:noreply@example.org

SERVER_PORT=8080
