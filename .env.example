# WordPress headless — AfrEA-YEE
# Copier vers .env et renseigner les valeurs réelles.
# Ne jamais committer .env (secrets / JWT).

# Base REST (préfixe /index.php/wp-json/ si mod_rewrite indisponible)
VITE_WP_API_URL=https://spiritdesign.socialracine.com/index.php/wp-json

# Simple JWT Login
VITE_JWT_AUTH_ENDPOINT=https://spiritdesign.socialracine.com/index.php/wp-json/simple-jwt-login/v1/auth

# false = appels API réels ; true ou absent = données mock (dev UI)
VITE_USE_MOCK=false
