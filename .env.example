# WordPress headless — AfrEA-YEE (App API)
# Copier vers .env et renseigner les valeurs réelles.
# Ne jamais committer .env (secrets / JWT).

# --- Dev local (recommandé) : proxy Vite → pas de CORS ---
VITE_WP_API_URL=/wp-json
VITE_APP_API_URL=/wp-json/app/v1
VITE_WP_PROXY_TARGET=https://sandybrown-rail-456461.hostingersite.com
VITE_API_TIMEOUT=15000

