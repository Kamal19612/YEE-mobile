# WordPress headless — AfrEA-YEE (App API)
# Copier vers .env et renseigner les valeurs réelles.
# Ne jamais committer .env (secrets / JWT).

# --- Dev local (recommandé) : proxy Vite → pas de CORS ---
VITE_WP_API_URL=/wp-json
VITE_APP_API_URL=/wp-json/app/v1
VITE_WP_PROXY_TARGET=https://wp.socialracine.com
VITE_API_TIMEOUT=15000

# --- Prod / GitHub Pages (injecté aussi par .github/workflows/deploy-pages.yml) ---
# Côté WP (wp-config.php) obligatoire pour la session au F5 :
#   define('APP_ALLOWED_ORIGINS', ['https://<user>.github.io']);
# Cookie refresh : SameSite=None par défaut (SPA cross-origin).
#   define('APP_COOKIE_SAMESITE', 'Lax'); // seulement si front et API same-site
# VITE_WP_API_URL=https://sandybrown-rail-456461.hostingersite.com/wp-json
# VITE_APP_API_URL=https://sandybrown-rail-456461.hostingersite.com/wp-json/app/v1
